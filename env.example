# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Neo4j配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用配置
LOG_LEVEL=INFO
CACHE_TTL=3600
MAX_CONCEPTS_PER_DOMAIN=5

