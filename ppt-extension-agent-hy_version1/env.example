# LLM API配置（使用SiliconFlow - DeepSeek模型，与agent.py保持一致）
# 已默认配置，可直接使用
LLM_API_KEY=sk-xunstfhbbfgnarbyombhjgybxxlzmgfzhtnhwageegbefgsc
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2-Exp
LLM_TEMPERATURE=0.7

# 兼容性配置（保留OpenAI字段用于其他LLM服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3.2-Exp

# 向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=ppt_chunks

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# 文件路径配置
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
LOG_DIR=./logs

# 嵌入模型配置
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 外部API配置（可选）
ARXIV_API_KEY=
WIKIPEDIA_LANG=zh

# 安全配置
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
