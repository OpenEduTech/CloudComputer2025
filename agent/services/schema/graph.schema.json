{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/graph.schema.json",
  "title": "跨学科知识图谱 GraphJSON Schema",
  "description": "用于跨学科知识图谱生成结果（nodes/edges/meta）的结构约束。中文为主：label/aliases/evidence 等字段使用中文；id 建议使用英文字母/拼音/简写以便作为键。",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nodes", "edges"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_concept", "normalized_concept", "domains", "version", "generated_at", "stats"],
      "properties": {
        "core_concept": {
          "type": "string",
          "minLength": 1,
          "description": "用户原始输入概念（中文为主）"
        },
        "normalized_concept": {
          "type": "string",
          "minLength": 1,
          "description": "规范化概念（用于缓存/落库键，可与 core_concept 相同）"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "系统预设学科域集合（固定枚举）",
          "items": { "$ref": "#/$defs/domain" }
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "生成版本标识（如 agent-v1 / mock-v1）"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间（ISO8601）"
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num_nodes", "num_edges", "num_domains_covered"],
          "properties": {
            "num_nodes": {
              "type": "integer",
              "minimum": 1,
              "description": "节点数（建议 10~30）"
            },
            "num_edges": {
              "type": "integer",
              "minimum": 0,
              "description": "边数（建议 15~50）"
            },
            "num_domains_covered": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "实际覆盖学科域数量（用于评测）"
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "可选：生成备注（例如校验层删除了哪些边/为什么降级）"
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "图谱节点列表（建议 10~30）",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "description": "图谱边列表（每条边必须可解释）",
      "minItems": 0,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": ["数学", "物理", "计算机/AI", "生物/神经科学", "社会科学/经济学"],
      "description": "预设学科域枚举（中文）"
    },
    "nodeType": {
      "type": "string",
      "enum": ["core", "bridge", "normal"],
      "description": "节点类型：core=核心概念；bridge=桥梁概念；normal=普通概念"
    },
    "direction": {
      "type": "string",
      "enum": ["directed", "undirected"],
      "description": "边方向性"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_\\-]+$",
      "description": "节点唯一 ID（建议用英文/拼音/简写，便于作为 key；展示用中文放 label）"
    },
    "relationType": {
      "type": "string",
      "enum": ["直接关联", "类比关联", "数学关联", "先修依赖", "应用关联", "因果/机制", "相对/对比", "其他"],
      "description": "关系类型（中文枚举，用于可视化分层与评测统计）"
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "来源标题（论文/教材/网页/课程笔记等）"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "可选：来源链接（如 DOI/网页）"
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "可选：简短备注（如页码、章节、引用片段概述）"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "field", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "展示名称（中文为主，可包含中英）"
        },
        "field": {
          "oneOf": [
            { "$ref": "#/$defs/domain" },
            {
              "type": "string",
              "const": "核心",
              "description": "可选：核心概念也可以标为“核心”（若不归入五域之一）"
            }
          ],
          "description": "所属学科域（或核心）"
        },
        "type": { "$ref": "#/$defs/nodeType" },
        "aliases": {
          "type": "array",
          "description": "别名/同义词（中文为主）",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "一句话解释（hover 展示用，建议提供）"
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "可选：重要度评分（影响可视化节点大小，0~1）"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "可选：节点可信度（若 agent 给出）"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation", "relation_type", "confidence", "evidence"],
      "properties": {
        "source": { "$ref": "#/$defs/nodeId" },
        "target": { "$ref": "#/$defs/nodeId" },
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "关系短语（用于展示，可为中文短语，例如：'形式化为'/'用于'/'对应'）"
        },
        "relation_type": { "$ref": "#/$defs/relationType" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "边可信度（0~1）"
        },
        "evidence": {
          "type": "string",
          "minLength": 4,
          "maxLength": 240,
          "description": "关系依据/解释（用于校验与前端展示，中文为主）"
        },
        "reasoning_chain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "可选：推理链（2~6条短句，用于解释关系成立的关键步骤）",
          "items": { "type": "string", "minLength": 2, "maxLength": 160 }
        },
        "bridge_concepts": {
          "type": "array",
          "description": "可选：桥梁概念（用于强调远亲链路中间节点，填 node.id）",
          "items": { "$ref": "#/$defs/nodeId" },
          "uniqueItems": true,
          "maxItems": 10
        },
        "sources": {
          "type": "array",
          "description": "可选：证据来源列表（论文/教材/网页等）。不要求每条边都给，但给了很加分。",
          "items": { "$ref": "#/$defs/sourceItem" },
          "maxItems": 5
        },
        "direction": {
          "$ref": "#/$defs/direction",
          "default": "directed",
          "description": "可选：方向性（默认有向）"
        },
        "tags": {
          "type": "array",
          "description": "可选：标签（如 '远亲概念'、'桥梁链路'、'低置信'）",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "uniqueItems": true,
          "maxItems": 10
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "source": { "const": "" }
            }
          }
        }
      ]
    }
  }
}
