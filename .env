# Authentication Configuration
# If you still need Zhipu in the future, keep the key only locally and
# do not commit it into version control.
# ZHIPU_API_KEY=your_zhipu_api_key_here

# Use Tongyi Qianwen (Qwen) via OpenAI-compatible API
OPENAI_API_KEY=xxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v1

# Database Configuration
# MONGO_URI=mongodb://localhost:27017/study_agent_db?directConnection=true
MONGO_URI=mongodb://root:example@localhost:27019/study_agent_db?authSource=admin&directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Development Mode Configuration
# Set to False to disable development mode (skip API validation)
DEV_MODE=False

# ocr识别
OCR_API_KEY=xxx