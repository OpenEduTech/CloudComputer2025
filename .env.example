# 跨学科知识图谱智能体 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的API密钥
# 命令: cp .env.example .env  (Linux/Mac) 或 copy .env.example .env (Windows)

# LLM API配置（支持OpenAI兼容API）
# 当前使用阿里云Qwen-turbo，也可以使用其他兼容API
MAAS_API_KEY=your_api_key_here
MAAS_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
MAAS_MODEL_NAME=qwen-turbo

# 或者使用OpenAI API（如果使用OpenAI）
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_API_BASE=https://api.openai.com/v1
# MODEL_NAME=gpt-4

# Redis配置（Docker Compose中会自动配置，本地开发时需要）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Flask配置
FLASK_ENV=production
FLASK_DEBUG=False

# 说明：
# 1. 复制此文件为 .env：cp .env.example .env (Linux/Mac) 或 copy .env.example .env (Windows)
# 2. 编辑 .env 文件，填入你的API密钥
# 3. Docker Compose会自动读取 .env 文件中的配置
# 4. 本地开发时，确保Redis已启动：docker run -d -p 6379:6379 redis:alpine