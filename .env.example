# DeepSeek API配置
DEEPSEEK_API_KEY=sk-5bfd2b56b45c4ac7a2be1b2d1045e061
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 可选：deepseek-reasoner
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding

# 应用配置
APP_NAME=PPT学习助手
APP_ENV=development
DEBUG=true

# 后端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# 前端配置
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=300000

# 数据库配置
# ChromaDB配置
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 文件上传配置
MAX_UPLOAD_SIZE=50  # MB
ALLOWED_EXTENSIONS=[".ppt",".pptx",".pdf"]

# 向量数据库配置
EMBEDDING_MODEL=deepseek-embedding
VECTOR_DIM=1024

# Agent配置
MAX_RETRIES=3
TIMEOUT=60
TEMPERATURE=0.7

# 外部API配置（可选）
WIKIPEDIA_API_ENABLED=true
ARXIV_API_ENABLED=true
SEMANTIC_SCHOLAR_API_ENABLED=false
OPENALEX_API_ENABLED=true
STACKEXCHANGE_API_ENABLED=false
BING_SEARCH_API_ENABLED=false
GOOGLE_CSE_API_ENABLED=false

# 外部API Key配置（可选）
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=2950776323@qq.com
STACKEXCHANGE_KEY=
BING_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# OCR配置
OCR_ENABLED=true
OCR_SEMANTIC_ENABLED=true
OUTLINE_SUMMARY_ENABLED=true
LLM_VALIDATION_ENABLED=true
TESSERACT_CMD=

# 本地预筛模型配置（可选）
LOCAL_PREFILTER_ENABLED=false
LOCAL_PREFILTER_MODEL_PATH=

# 评分增强配置
ANSWER_SIMILARITY_THRESHOLD=0.55
